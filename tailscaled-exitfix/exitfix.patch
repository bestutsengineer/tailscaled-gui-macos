new file mode 100644
index 0000000..3352639
--- /dev/null
+++ b/wgengine/router/osrouter/router_darwin_split.go
@@ -0,0 +1,143 @@
+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+//go:build darwin || freebsd
+
+package osrouter
+
+import (
+	"net"
+	"net/netip"
+	"runtime"
+
+	"go4.org/netipx"
+	"tailscale.com/types/logger"
+)
+
+// darwinExitFixMarker lets tools tell this build apart from upstream tailscaled.
+const darwinExitFixMarker = "tailscaled-darwin-exitfix-v2"
+
+// scopedRoute is an on-link route pinned to its interface (`route add -ifscope`).
+type scopedRoute struct {
+	prefix netip.Prefix
+	ifname string
+}
+
+// splitConflictingRoutes rewrites the routes macOS can't add with `route add -iface utunX`
+// because the OS already owns the same prefix: the default route (an exit node) and the
+// on-link prefixes of the Mac's own interfaces (an exit node with LAN access off).
+// `route add` fails with EEXIST for those, so the traffic never enters the tunnel, and the
+// matching `route delete` later removes the OS's own route instead. Each one is replaced by
+// its two halves, as other VPNs do: they win by longest-prefix match, and deleting them never
+// touches Wi-Fi's routes. tailscaled's own sockets are bound to the physical interface
+// (net/netns, IP_BOUND_IF), so its WireGuard, DERP and control traffic keeps using Wi-Fi.
+// Link-local prefixes are dropped: they can't be routed into a tunnel.
+//
+// A split on-link prefix also comes back as a scoped route on its interface. Adding the halves
+// flushes the LAN's cached neighbour routes, and a socket bound to Wi-Fi finds no LAN route of
+// its own after that, so tailscaled's WireGuard to a peer on the same LAN (often the exit node
+// itself) would fall into the tunnel. The scoped route only applies to bound sockets.
+func splitConflictingRoutes(logf logger.Logf, routes []netip.Prefix, tunname string) (out []netip.Prefix, scoped []scopedRoute) {
+	if runtime.GOOS != "darwin" {
+		return routes, nil
+	}
+	onLink := onLinkPrefixes(tunname)
+	out = make([]netip.Prefix, 0, len(routes)+4)
+	for _, p := range routes {
+		p = p.Masked()
+		ifname, isOnLink := onLink[p]
+		switch {
+		case p.Addr().IsLinkLocalUnicast():
+			continue
+		case p.Bits() == 0 || (isOnLink && p.Bits() < p.Addr().BitLen()):
+			lo, hi := halves(p)
+			logf("%s: route %v installed as %v and %v", darwinExitFixMarker, p, lo, hi)
+			out = append(out, lo, hi)
+			if isOnLink {
+				scoped = append(scoped, scopedRoute{p, ifname})
+			}
+		default:
+			out = append(out, p)
+		}
+	}
+	return out, scoped
+}
+
+// halves splits p into the two prefixes one bit longer than it.
+func halves(p netip.Prefix) (lo, hi netip.Prefix) {
+	bits := p.Bits()
+	base := p.Masked().Addr()
+	b := base.AsSlice()
+	b[bits/8] |= 0x80 >> (bits % 8)
+	hiAddr, _ := netip.AddrFromSlice(b)
+	return netip.PrefixFrom(base, bits+1), netip.PrefixFrom(hiAddr, bits+1)
+}
+
+// onLinkPrefixes maps the subnets of the Mac's up interfaces, other than the tunnel, to their interface.
+func onLinkPrefixes(tunname string) map[netip.Prefix]string {
+	m := map[netip.Prefix]string{}
+	ifaces, err := net.Interfaces()
+	if err != nil {
+		return m
+	}
+	for _, ifc := range ifaces {
+		if ifc.Name == tunname || ifc.Flags&net.FlagUp == 0 {
+			continue
+		}
+		addrs, err := ifc.Addrs()
+		if err != nil {
+			continue
+		}
+		for _, a := range addrs {
+			ipn, ok := a.(*net.IPNet)
+			if !ok {
+				continue
+			}
+			if pfx, ok := netipx.FromStdIPNet(ipn); ok {
+				m[pfx.Masked()] = ifc.Name
+			}
+		}
+	}
+	return m
+}
+
+// setScopedRoutes adds the scoped routes in want that aren't in place yet and removes the ones
+// added earlier that are no longer wanted. A route the OS already had (add fails) isn't ours,
+// so it's never deleted.
+func (r *userspaceBSDRouter) setScopedRoutes(want []scopedRoute) {
+	if runtime.GOOS != "darwin" {
+		return
+	}
+	keep := make(map[scopedRoute]bool, len(want))
+	for _, s := range want {
+		keep[s] = true
+	}
+	for s := range r.scoped {
+		if !keep[s] {
+			r.scopedRouteCmd("delete", s)
+			delete(r.scoped, s)
+		}
+	}
+	for _, s := range want {
+		if r.scoped[s] {
+			continue
+		}
+		if r.scopedRouteCmd("add", s) {
+			if r.scoped == nil {
+				r.scoped = make(map[scopedRoute]bool)
+			}
+			r.scoped[s] = true
+		}
+	}
+}
+
+func (r *userspaceBSDRouter) scopedRouteCmd(op string, s scopedRoute) bool {
+	args := []string{"route", "-q", "-n", op, "-" + inet(s.prefix), s.prefix.String(),
+		"-interface", s.ifname, "-ifscope", s.ifname}
+	out, err := cmd(args...).CombinedOutput()
+	if err != nil {
+		r.logf("%s: %v: %v\n%s", darwinExitFixMarker, args, err, out)
+		return false
+	}
+	return true
+}
diff --git a/wgengine/router/osrouter/router_darwin_split_test.go b/wgengine/router/osrouter/router_darwin_split_test.go
