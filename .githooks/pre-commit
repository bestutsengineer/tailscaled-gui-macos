#!/bin/sh
# Blocks commits that contain secrets (gitleaks) or that would publish a non-GitHub author email.
# Enable once per clone: git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks not found. Install it (brew install gitleaks) or commit with --no-verify at your own risk." >&2
    exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner || exit 1

email=$(git config user.email)
case "$email" in
    *@users.noreply.github.com) ;;
    *)
        echo "pre-commit: author email '$email' would be published with this commit." >&2
        echo "Use your GitHub no-reply address: git config user.email <id>+<user>@users.noreply.github.com" >&2
        exit 1 ;;
esac
